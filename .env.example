# =============================================================================
# Roadmap de Cursos — variables de entorno de DESARROLLO (TRD §4.4)
# Uso: cp .env.example .env   (el .env real nunca se versiona)
# Los valores de abajo son solo para desarrollo local: no son secretos reales.
# =============================================================================

# --- PostgreSQL (contenedor) --------------------------------------------------
POSTGRES_USER=roadmap
POSTGRES_PASSWORD=roadmap_dev
POSTGRES_DB=roadmap

# --- Backend -----------------------------------------------------------------
# El host "postgres" es el nombre del servicio en docker-compose.yml.
DATABASE_URL=postgresql+psycopg://roadmap:roadmap_dev@postgres:5432/roadmap
APP_ENV=dev
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# Sesión y cookies (TRD §2.4)
COOKIE_SECURE=false
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
TRUST_PROXY_HEADERS=false

# Correo de desarrollo: Mailpit (se suma al compose con la recuperación de contraseña, tarea 1.4)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@roadmap.local

# Validador inicial (opcional): si se completan, el seed lo crea al arrancar
SEED_VALIDADOR_EMAIL=
SEED_VALIDADOR_NOMBRE=
SEED_VALIDADOR_PASSWORD=

# --- Frontend ----------------------------------------------------------------
# Destino del proxy /api de Vite: "backend" dentro de Docker, localhost fuera de Docker.
VITE_PROXY_TARGET=http://backend:8000
